# === OpenAI ===
# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Realtime model to use
OPENAI_REALTIME_MODEL=gpt-realtime

# Voice used for AI speech output (alloy, echo, shimmer, ash, ballad, coral, sage, verse)
OPENAI_VOICE=alloy

# === VAD / turn-detection tuning ===
# How much silence (ms) must follow speech before the turn is considered "done".
# Higher = more tolerant of "um...", pauses, trailing off. Lower = snappier turn-taking.
VAD_SILENCE_DURATION_MS=400

# Server VAD sensitivity (0-1). Higher = requires louder/clearer speech to trigger.
VAD_THRESHOLD=0.5

# How much audio (ms) to keep *before* detected speech start, so the first phoneme isn't clipped.
VAD_PREFIX_PADDING_MS=300

# === Server ===
# Comma-separated list of allowed origins for CORS / WS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=0.0.0.0
PORT=8000
